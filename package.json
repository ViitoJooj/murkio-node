{
  "name": "@murkio/node",
  "version": "0.1.0",
  "description": "Murkio identity for Node and edge runtimes: verifies the session of each request (Express, Hono, Next, SvelteKit, Bun) and writes the login components into server-rendered pages.",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "jose": "6.2.12"
  },
  "devDependencies": {
    "@murkio/html": "0.1.0"
  },
  "engines": {
    "node": ">=20"
  }
}
