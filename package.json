{
  "name": "@murkio/node",
  "version": "0.1.0",
  "description": "Murkio identity for Node and edge runtimes: verifies the session of each request (Express, Hono, Next, SvelteKit, Bun) and writes the login components into server-rendered pages.",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ViitoJooj/murkio-node.git"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "prepare": "npm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint --error-on-warnings .",
    "package:check": "publint --strict"
  },
  "dependencies": {
    "jose": "6.2.12"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "26.6.4",
    "publint": "0.3.25",
    "tsup": "8.5.1",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "esbuild": false
  }
}
